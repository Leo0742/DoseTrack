ENVIRONMENT=production
APP_SECRET_KEY=replace-with-a-long-random-secret
POSTGRES_DB=dosetrack
POSTGRES_USER=dosetrack
POSTGRES_PASSWORD=replace-with-a-long-random-password
FRONTEND_URL=https://example.com
PUBLIC_BASE_URL=https://example.com
CADDY_ADDRESS=example.com
SECURE_COOKIES=true
SESSION_DAYS=30
DEFAULT_TIMEZONE=Europe/Moscow
MAX_UPLOAD_MB=25
WORKER_POLL_SECONDS=30

# Initial owner bootstrap. Run once, then remove BOOTSTRAP_OWNER_PASSWORD from .env.
BOOTSTRAP_OWNER_EMAIL=owner@example.com
BOOTSTRAP_OWNER_USERNAME=owner
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-password

# Telegram bot token. Keep secret; never commit it.
TELEGRAM_BOT_TOKEN=

# Optional off-server restic backup.
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
