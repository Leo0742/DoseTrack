{$CADDY_ADDRESS:http://localhost} {
  encode zstd gzip

  @backend path /api/* /health /readiness
  reverse_proxy @backend backend:8000
  reverse_proxy frontend:3000

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  # Keep clickjacking protection strict everywhere, except for the document
  # content endpoint which is intentionally embedded by our own PDF preview.
  @document_content path /api/documents/*/content
  header @document_content {
    X-Frame-Options "SAMEORIGIN"
    Content-Security-Policy "default-src 'none'; frame-ancestors 'self'"
  }

  @not_document_content not path /api/documents/*/content
  header @not_document_content {
    X-Frame-Options "DENY"
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  }

  @https expression {scheme} == "https"
  header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
